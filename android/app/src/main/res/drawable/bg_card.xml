<?xml version="1.0" encoding="utf-8"?>
<!-- A restrained pearlescent rim around a true-black instrument surface. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/indigo_500"
                android:centerColor="@color/violet_500"
                android:endColor="@color/pearl_mint" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/slate_900" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
