<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Theme.Anima — jet-black instrument theme with pearlescent controls.
        Extends Material 3 so MainActivity's Material components (buttons,
        text fields) pick up the same palette as the overlay.
    -->
    <style name="Theme.Anima" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pearl_white</item>
        <item name="colorPrimaryVariant">@color/pearl_blue</item>
        <item name="colorOnPrimary">@color/ink_on_pearl</item>

        <item name="colorSecondary">@color/pearl_lilac</item>
        <item name="colorSecondaryVariant">@color/pearl_blue</item>
        <item name="colorOnSecondary">@color/ink_on_pearl</item>

        <item name="android:colorBackground">@color/slate_950</item>
        <item name="colorOnBackground">@color/white</item>

        <item name="colorSurface">@color/slate_900</item>
        <item name="colorOnSurface">@color/white</item>

        <item name="android:statusBarColor">@color/slate_950</item>
        <item name="android:navigationBarColor">@color/slate_950</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="android:windowBackground">@color/slate_950</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/slate_300</item>
    </style>

</resources>
