<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
         Product-surface permissions only. Everything the agent itself needs
         (accessibility, overlay, foreground service, vibration) is declared by
         :capture and merged in from there.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Anima Autonomous Agent"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anima">

        <!-- Launcher Activity: judge-facing onboarding, permission gate, goal runner, 3-act demo -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Anima">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- External Automation Receiver: Tasker & MacroDroid Intent API -->
        <receiver
            android:name=".TaskerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.agents.anima.RUN_TASK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
