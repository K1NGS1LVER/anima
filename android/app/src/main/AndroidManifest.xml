<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
         Product-surface permissions only. Everything the agent itself needs
         (accessibility, overlay, foreground service, vibration) is declared by
         :capture and merged in from there.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Anima Autonomous Agent"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anima">

        <!-- Launcher Activity: onboarding, app selection, scan control and pack viewer. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Anima">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             S4 hardware bring-up harness, not a product feature. See the
             class doc on DebugScanReceiver. Runs the real Explorer,
             ScanOrchestrator, KnowledgeStore and PackArchive pipeline from an
             adb broadcast. MainActivity still drives its scan screen off a
             scripted FakeScanController (see its own note about G6), so this
             stays the only way to produce a real pack until N4 swaps to the
             real ScanController. Remove once it does.
        -->
        <receiver
            android:name=".DebugScanReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.agents.anima.DEBUG_SCAN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
